# Copy to .env.local for local dev. In production (Vercel), set these as
# project Environment Variables instead — never commit a real .env file.

# --- Database (Turso — https://turso.tech, free tier is plenty to start) ---
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=
# For local dev without a Turso account, you can point this at a local file
# instead: TURSO_CONNECTION_URL=file:./data/dev.db (leave TURSO_AUTH_TOKEN unset)

# --- ViralHive dashboard auth & encryption ---
# Generate each with: openssl rand -base64 32
VIRALHIVE_ADMIN_PASSWORD=
VIRALHIVE_ENCRYPTION_KEY=
VIRALHIVE_SESSION_SECRET=

# --- Autonomous execution ---
# Vercel automatically sends this as a Bearer token when it invokes your
# cron job (see vercel.json) — set the same value here.
CRON_SECRET=
