# ---------------------------------------------------------------------------
# iProsper AI Calendar + Encrypted Email — environment configuration
# Copy to .env.local (Next.js) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (libSQL / Turso). For local dev you can use a file URL.
TURSO_CONNECTION_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Mailbox encryption key (REQUIRED for the email system).
# 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means losing access to all stored mail. Back it up.
MAIL_ENCRYPTION_KEY=

# The address this mailbox "owns" (what outbound mail is sent as).
MAILBOX_ADDRESS=owner@iprosper.ai

# Shared secret the voice agent presents to /api/voice-agent (REQUIRED for the
# autonomous agent). Generate a long random string and give it to your voice
# platform (Vapi / Retell / Bland / Twilio / Cartesia, etc.).
VOICE_AGENT_API_KEY=

# Claude API key — powers natural-language scheduling, mail triage, and drafting.
# Without it, the system falls back to deterministic heuristics (still works).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Outbound email delivery (optional). Without it, sent mail is stored and
# queued locally. Set to actually put mail on the wire via Resend.
RESEND_API_KEY=
