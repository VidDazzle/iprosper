# Solvana environment configuration
# Copy to .env.local and fill in. All values are optional in dev — pixels and
# CAPI no-op cleanly when unset.

# --- Database (Turso / libSQL) ---
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# --- Ad conversion tracking (client-side pixels) ---
# Exposed to the browser (NEXT_PUBLIC_*). Safe to be public.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=      # AW-XXXXXXXXX
NEXT_PUBLIC_GA4_ID=             # G-XXXXXXXXX

# --- Meta Conversions API (server-side, keep secret) ---
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Client portal & admin ---
# Secret used to sign portal + admin session cookies and approval tokens.
# REQUIRED in production. Generate: openssl rand -hex 32
SESSION_SECRET=
# Base URL used in approval email/SMS links.
NEXT_PUBLIC_SITE_URL=https://solvana.ai

# --- Staff (admin console) credentials ---
# Without these, a dev-only fallback admin (admin@solvana.ai / admin1234) is
# used in non-production; in production the console is locked until set.
ADMIN_EMAIL=
# scrypt "salt:hash" for the staff password. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_PASSWORD_HASH=

# --- Notifications: email + SMS (optional; log to server if unset) ---
RESEND_API_KEY=            # transactional email (approvals, attorney pings, booking confirmations)
TWILIO_ACCOUNT_SID=        # SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Web push (VAPID) — pings clients/attorneys instantly in-browser ---
# Generate a key pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=              # base64url, 65-byte P-256 point (server)
VAPID_PRIVATE_KEY=            # base64url, 32-byte scalar (keep secret)
VAPID_SUBJECT=mailto:notify@xdebt.ai
NEXT_PUBLIC_VAPID_PUBLIC_KEY= # same public key, exposed to the browser
