# --- APEX system configuration ---
# Copy to .env and fill in. Never commit .env. Never paste real values
# back into chat/PRs — only confirm keys are set by name.

# Ships false. Nothing contacts a real person or spends real money
# until this is manually and deliberately flipped after human review.
LIVE_MODE=false

# Per-channel outbound switches — each layers UNDER LIVE_MODE, so
# flipping LIVE_MODE=true does NOT by itself enable any of these.
# Flip one at a time and confirm a real provider is wired first.
SMS_ENABLED=false
VOICE_ENABLED=false
EMAIL_ENABLED=false

DATABASE_URL="postgresql://apex:apex@localhost:5432/apex"
REDIS_URL="redis://localhost:6379"

# Hard ceiling on cost-to-generate for a single Rebrand Engine preview
# (Phase 2 cost guard; reserved here now since packages/config reads it).
MAX_COST_PER_PREVIEW=5

# --- Rebalance thresholds (Phase 1) ---
# NOT specified numerically in the spec ("clearly outperforms" /
# "below target" have no defined number) — these are placeholders.
# A human should set the real values before Sunday's rebalance cron
# is allowed to make real budget-allocation decisions.
REBALANCE_WIN_MARGIN=0.05
REBALANCE_TARGET_ROI=0

# --- Phase 1 ---
ANTHROPIC_API_KEY=
# Signs preview URLs and admin sessions (HMAC). Generate with:
# openssl rand -hex 32
AUTH_SECRET=

# --- Phase 2 (Rebrand Engine) ---
# Base URL preview links are built against — must match wherever
# apps/web is actually served (e.g. https://preview.yourdomain.com).
PREVIEW_BASE_URL=http://localhost:3000

# Argon2id hash of the admin dashboard password (never the plaintext).
# Generate with hashPassword() in apps/web/src/lib/adminAuth.ts.
# 2FA and TLS termination are NOT implemented — see the comment in
# adminAuth.ts before pointing this at a real password.
ADMIN_PASSWORD_HASH=

ELEVENLABS_API_KEY=

# --- Phase 3 (revenue attribution webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# No specific invoicing/affiliate-network provider is named in the
# spec — these gate a provider-agnostic HMAC-SHA256 webhook payload
# pending a real platform choice. See apps/web/src/app/api/webhooks/.
INVOICING_WEBHOOK_SECRET=
AFFILIATE_WEBHOOK_SECRET=

# --- Per-stage cost placeholders (Phase 2) ---
# NOT sourced from real API pricing — see packages/pipeline/src/costs.ts.
STAGE_COST_SCRAPE=0.05
STAGE_COST_EXTRACT=0.3
STAGE_COST_RENDER=0.05
STAGE_COST_VOICE=0.5

# --- Scout scoring (Phase 4) ---
# None of these are spec-defined numbers — see packages/scout/src/scoring.ts.
SCOUT_CONFIDENCE_WEIGHT_LOW=0.3
SCOUT_CONFIDENCE_WEIGHT_MED=0.6
SCOUT_CONFIDENCE_WEIGHT_HIGH=1.0
SCOUT_BASE_INFRA_PENALTY=40
SCOUT_PER_REUSE_CREDIT=8
SCOUT_SCORE_THRESHOLD=1

# --- Sweeper (Phase 3, spec Section 3) ---
# Backoff curve isn't spec-defined beyond "with backoff" — see
# packages/dispatch/src/sweeper.ts.
SWEEPER_BACKOFF_BASE_MS=300000

# --- Closer touch timing (Phase 2, spec Section 6) ---
# Only the email delay (T+2h) is spec-defined; the SMS->voice gap
# isn't — see packages/pipeline/src/closer.ts.
CLOSER_VOICE_DELAY_MS=3600000
CLOSER_EMAIL_DELAY_MS=7200000

# --- Self-check heartbeat (not spec-defined) ---
# How stale the latest heartbeat can be before the admin dashboard
# flags the apex background process as possibly dead — see
# packages/health.
HEARTBEAT_STALE_AFTER_MS=600000

# --- Closer social-proof stat (not spec-defined) ---
# Real closed-client count per engine, gated by a minimum sample size
# so one early client doesn't get dressed up as "dozens of
# businesses" — see packages/pipeline/src/socialProof.ts. This is the
# ONLY "outcome" claim the closer email can honestly make; nothing
# measures a client's own traffic or revenue after they buy (no
# analytics integration on delivered sites).
SOCIAL_PROOF_MIN_SAMPLE=10

# --- Gemini mock-site generation + Netlify per-prospect hosting (not spec-defined) ---
# Two separate real-world-side-effect gates, layered under LIVE_MODE
# like every other channel: generation spends real Gemini API money;
# deploy additionally makes a real, publicly-hosted site under the
# prospect's name. Both default false even with LIVE_MODE=true.
GEMINI_SITE_ENABLED=false
NETLIFY_DEPLOY_ENABLED=false

GEMINI_API_KEY=
# Placeholder model name — swap for whatever you actually want once
# this is smoke-tested against a real key. See packages/mocksite.
GEMINI_MODEL=gemini-2.5-flash

# One pre-created Netlify site that receives a new non-production
# deploy per prospect (each deploy gets its own unique preview
# subdomain from Netlify) — no per-prospect site creation needed.
NETLIFY_API_KEY=
NETLIFY_SITE_ID=

# --- Mock-site stage cost placeholders (not sourced from real pricing) ---
STAGE_COST_GEMINI_SITE=0.1
STAGE_COST_NETLIFY_DEPLOY=0.01

# --- Autonomous Scout approval (not spec-defined) ---
# "Full autonomy with hard caps": candidates that score well AND stay
# under AUTONOMOUS_DISPATCH_CAP auto-dispatch with zero human
# involved. Anything that would exceed the caps, or carries a
# compliance flag, still needs a human — delivered as a one-click
# link via SMS/email instead of requiring dashboard login. Master
# switch defaults off; both LIVE_MODE and this must be true.
AUTONOMOUS_APPROVAL_ENABLED=false

# Fixed ceiling for any candidate the system approves on its own.
# Conservative placeholder — not derived from the candidate's own
# revenue projection. Raise it once you've watched a few play out.
AUTONOMOUS_DISPATCH_CAP=15

# Rolling 7-day ceiling on total budgetCap committed via autonomous
# (not human) approval — caps how fast autonomous spend can compound.
AUTONOMOUS_WEEKLY_SPEND_CAP=100

# Amount proposed in a human-approval-request link (a one-click link
# can't collect a typed-in number, so the amount is stated up front).
AUTONOMOUS_ESCALATION_CAP=50

# Where autonomous-approval requests and real-time kill-switch alerts
# get sent. Unset -> those alerts stay dry-run (logged, not delivered).
OWNER_PHONE_NUMBER=
OWNER_EMAIL=
