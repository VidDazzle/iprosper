# ---------------------------------------------------------------------------
# iProsper AI Calendar + Encrypted Email — environment configuration
# Copy to .env.local (Next.js) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (libSQL / Turso). For local dev you can use a file URL.
TURSO_CONNECTION_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Mailbox encryption key (REQUIRED for the email system).
# 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means losing access to all stored mail. Back it up.
MAIL_ENCRYPTION_KEY=

# The address this mailbox "owns" (what outbound mail is sent as).
MAILBOX_ADDRESS=owner@iprosper.ai

# First-contact welcome banner, prepended the first time Evolve emails a new
# recipient. Override the default copy here.
WELCOME_MESSAGE="We ditched our other email providers because they weren't secure enough and they didn't rock like Evolve!!!"

# Shared secret the voice agent presents to /api/voice-agent (REQUIRED for the
# autonomous agent). Generate a long random string and give it to your voice
# platform (Vapi / Retell / Bland / Twilio / Cartesia, etc.).
VOICE_AGENT_API_KEY=

# Claude API key — powers natural-language scheduling, mail triage, and drafting.
# Without it, the system falls back to deterministic heuristics (still works).
# Get a key at https://console.anthropic.com/ (starts with "sk-ant-").
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8 (most capable) if unset.
AI_MODEL=claude-opus-4-8

# Outbound email delivery (optional). Without it, sent mail is stored and
# queued locally. Set to actually put mail on the wire via Resend.
RESEND_API_KEY=

# Object storage for large attachments (documents, full-length video). Works
# with AWS S3, Cloudflare R2, Backblaze B2, or MinIO. Without these, the mailbox
# still works but attachment uploads return 503.
# Enable the bucket's DEFAULT ENCRYPTION for at-rest encryption of the blobs,
# and set a CORS policy allowing PUT from your app origin with ExposeHeaders: ETag.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For R2 / B2 / MinIO set the S3-compatible endpoint (omit for AWS S3):
S3_ENDPOINT=
# Set true for MinIO / some R2 configs:
S3_FORCE_PATH_STYLE=

# Inbound email: point your provider's parse webhook at POST /api/mail/inbound.
# If set, requests must present this secret (?secret= or x-inbound-secret).
MAIL_INBOUND_SECRET=
# Calendar reminder lookahead window (minutes). Default 1440 (24h) suits a daily
# cron; lower it and use an hourly cron for tighter reminder timing.
REMINDER_WINDOW_MINUTES=1440

# Secret for the scheduled self-maintenance cron (/api/maintenance/cron).
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
# A long random string; gives the scheduler its own least-privilege credential.
CRON_SECRET=

# Minimum gross margin over cost for the profit guarantee (0.5 = 50% markup
# floor). The app refuses to boot if any configured price would earn less.
MIN_MARGIN=0.5

# Payments for the shareable purchase page + metered credit top-ups (optional).
# Without these, orders are "pending" (manual mode); with them, buyers go to
# Stripe Checkout and the webhook grants credits on payment.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint — verifies "payment succeeded" events.
STRIPE_WEBHOOK_SECRET=

# CRM follow-up automation (runs on the daily cron). New leads older than this
# with no contact get an auto first-touch email; open deals not updated in
# STALE_DEAL_DAYS get rolled into a digest to the owner.
FOLLOWUP_MIN_AGE_MINUTES=60
STALE_DEAL_DAYS=7

# Birthday-surprise mailer. Birthdays are matched against "today" in this
# timezone; the surprise line is included verbatim in the email.
BIRTHDAY_TZ=America/New_York
BIRTHDAY_SURPRISE="a free month of Evolve on us — just reply \"birthday\" and the AI will take it from there"

# ---------------------------------------------------------------------------
# Evolve Life — personal AI concierge (entertainment, food, recreation,
# health, reminders). All optional: without keys the concierge still works
# using curated fallbacks + live Google Maps search links.
# ---------------------------------------------------------------------------
# Default owner email for the single-user profile (defaults to MAILBOX_ADDRESS).
LIFE_OWNER_EMAIL=
# Places + reviews (restaurants, "closest Sprouts", gyms). Google Places API
# (new). Without it, suggestions use curated stand-ins + Maps search links.
GOOGLE_PLACES_API_KEY=
# Movies now-playing (TMDB v4 read token, "Bearer"). Without it, curated picks.
TMDB_API_KEY=
# Text-message reminders (the "text" channel). Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push-notification reminders (the "notification" channel). Web Push / VAPID.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@iprosper.ai
# Voice reminders reuse VOICE_AGENT_API_KEY (above) — the agent places the call.

# ---------------------------------------------------------------------------
# Evolve Together — two connected people share calendars/location, plan dates,
# and share private photos gated behind identity verification.
# ---------------------------------------------------------------------------
# Identity/KYC provider for the "driver's license + face match" check before
# photo sharing. Stripe Identity by default (reuses STRIPE_SECRET_KEY above).
# NOTE: OpenAI does NOT offer identity/biometric verification — use a real KYC
# provider. Persona / Onfido / Veriff are drop-in (swap src/lib/identity.ts).
# We store ONLY pass/fail — never the ID image or face data.
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Alternatives (if not using Stripe Identity):
PERSONA_API_KEY=
ONFIDO_API_TOKEN=
# Without any provider key, verification runs in a labeled SANDBOX so the flow
# is testable; set a provider key to require a real license + face match.

# ---------------------------------------------------------------------------
# Evolve Discover — background screening (anti-trafficking / offender gate).
# After identity verification, a compliant CRA screens sex-offender registries
# and criminal watchlists; anyone flagged for a disqualifying category is barred
# from being discoverable / tapping. We store ONLY the outcome, never records.
# ⚖️ FCRA & fair-chance laws apply — see EVOLVE_DISCOVER_HANDOFF.md.
# ---------------------------------------------------------------------------
CHECKR_API_KEY=
STERLING_API_KEY=
SCREENING_API_KEY=
# Comma-separated disqualifying categories (defaults cover the trafficking /
# sexual-violence set): sex_offense,human_trafficking,violent_felony,kidnapping,child_abuse
SCREENING_DISQUALIFIERS=

# ---------------------------------------------------------------------------
# Moderation dashboard (/moderation) — trust & safety back office for Discover.
# Reviews abuse reports + background-screening flags; lets a moderator suspend
# a member (which pulls them from Discover and blocks re-enabling it).
# If MODERATION_SECRET is UNSET, the dashboard + APIs are open (fine for local
# dev). In production, SET it: the /api/moderation/* routes then require it via
# "Authorization: Bearer <secret>" or an "x-moderation-secret" header, and the
# /moderation page prompts for it (stored client-side only).
# ---------------------------------------------------------------------------
MODERATION_SECRET=
