[Unit]
Description=ViralHive autonomous social media agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/viralhive
EnvironmentFile=/opt/viralhive/.env
ExecStart=/usr/bin/node /opt/viralhive/dist/cli.js daemon
Restart=always
RestartSec=5
User=viralhive
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
