{
  "name": "viralhive",
  "version": "0.2.0",
  "private": true,
  "description": "ViralHive: a self-optimizing, autonomous multi-account social video agent swarm with an MCP control surface.",
  "type": "module",
  "bin": {
    "viralhive": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "dev:daemon": "tsx src/cli.ts daemon",
    "dev:mcp": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:daemon": "node dist/cli.js daemon",
    "start:mcp": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "stripe": "^17.4.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
