# ─────────────────────────────────────────────────────────────────────────────
# Evolve AI OS — environment configuration
# Copy to `.env` for local dev. In staging/production, inject these from a
# secret manager (AWS Secrets Manager, GCP Secret Manager, Vault). NEVER commit
# real secrets. Generate the secret values with:  npm run keygen
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production
# In staging/production the KMS + token keys below are MANDATORY (boot fails
# without them). In development, ephemeral keys are generated automatically.
EVOLVE_ENV=development

# Control-plane HTTP port
EVOLVE_PORT=8787

# 32+ bytes of entropy, base64-encoded. Root key for the KMS keyring.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVOLVE_KMS_ROOT_KEY=

# Ed25519 signing keypair (PEM) for verifiable tokens + audit anchoring.
# Generate both with:  npm run keygen
EVOLVE_TOKEN_KID=evt-2026-1
EVOLVE_TOKEN_PRIVATE_KEY=
EVOLVE_TOKEN_PUBLIC_KEY=

# Token lifetime (seconds)
EVOLVE_TOKEN_TTL_SEC=3600

# Default per-principal rate limit (token bucket)
EVOLVE_RATE_PER_SEC=20
EVOLVE_RATE_BURST=60

# Admin key required to call /v1/auth/bootstrap outside development.
EVOLVE_ADMIN_KEY=
